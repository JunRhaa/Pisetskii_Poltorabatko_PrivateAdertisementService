<Page x:Class="Pisetskii_Poltorabatko_PrivateAdertisementService.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pisetskii_Poltorabatko_PrivateAdertisementService"
      mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">
    <Grid Margin="50">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="500" >

            <StackPanel Grid.Row="0" Margin="0 0 0 20">
                <TextBlock Text="Логин"
                       FontFamily="Tw Cen MT"
                       Margin="0 0 0 5"
                       FontSize="14"/>
                <TextBox x:Name="LoginBox"
                     Height="30"
                     FontFamily="Tw Cen MT"
                     Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0 0 0 20">
                <TextBlock Text="Пароль"
                       FontFamily="Tw Cen MT"
                       Margin="0 0 0 5"
                       FontSize="14"/>
                <PasswordBox x:Name="PasswordBox"
                         Height="30"
                         Padding="5"/>
            </StackPanel>

            <Button Grid.Row="2"
                Content="Войти"
                Width="200"
                Height="30"
                Background="#FF9C1A"
                Foreground="White"
                FontFamily="Tw Cen MT"
                Margin="0 0 0 20"
                Click="Login_Click"/>



            <Button Grid.Row="3" 
                Content="Войти как гость"
                Width="200"
                Height="30"
                FontFamily="Tw Cen MT"
                Click="Guest_Click"/>
        </StackPanel>
    </Grid>
</Page>
