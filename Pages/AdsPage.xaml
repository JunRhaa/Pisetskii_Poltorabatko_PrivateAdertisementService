<Page x:Class="Pisetskii_Poltorabatko_PrivateAdertisementService.AdsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pisetskii_Poltorabatko_PrivateAdertisementService"
      mc:Ignorable="d" 
           d:DesignHeight="450" d:DesignWidth="800"
       Title="Все объявления">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#37474F" />
        <SolidColorBrush x:Key="SecondaryText" Color="#78909C" />
        <SolidColorBrush x:Key="AccentColor" Color="#FF9C1A" />
    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DockPanel Margin="0 0 0 16">

                <TextBlock Text="Все объявления"
                       FontFamily="Tw Cen MT"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryText}"
                       />

                <Button Content="Добавить объявление"
                        FontFamily="Tw Cen MT"
                        FontSize="14"
                        Height="38"
                        Foreground="White"
                        Background="{StaticResource AccentColor}"
                        Padding="10"
                        HorizontalAlignment="Right"
                        Click="AddAd_Click"/>
            </DockPanel>

            <TextBox x:Name="SearchBox"
                     FontFamily="Tw Cen MT"
                     FontSize="14"
                     Height="30"
                     Margin="0 0 0 16"
                     ToolTip="Поиск по названию или описанию..."
                     TextChanged="FilterChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">

                <ComboBox x:Name="CityFilter"
                  Width="150"
                  Margin="0 0 16 0"
                  Height="30"
                  FontFamily="Tw Cen MT"
                  ToolTip="Город"
                  SelectionChanged="FilterChanged"/>

                <ComboBox x:Name="CategoryFilter"
                  Width="150"
                  Margin="0 0 16 0"
                  Height="30"
                  FontFamily="Tw Cen MT"
                  ToolTip="Категория"
                  SelectionChanged="FilterChanged"/>

                <ComboBox x:Name="TypeFilter"
                  Width="150"
                  Height="30"
                  Margin="0 0 16 0"
                  FontFamily="Tw Cen MT"
                  ToolTip="Тип"
                  SelectionChanged="FilterChanged"/>

                <Button Content="Сбросить"
                Width="120"
                Height="30"
                Background="{StaticResource AccentColor}"
                Foreground="White"
                FontFamily="Tw Cen MT"
                Click="ResetFilters_Click"/>


            </StackPanel>

        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="AdsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0 0 0 16"
                                Background="White">

                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{Binding ImagePath}"
                                       Width="140"
                                       Height="140"
                                       Stretch="UniformToFill"
                                       />

                                <StackPanel Grid.Column="1" Margin="16 0 0 0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="20"
                                               FontFamily="Tw Cen MT"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryText}" />

                                    <TextBlock Text="{Binding Description}"
                                               Margin="0 6 0 6"
                                               FontFamily="Tw Cen MT"
                                               Foreground="{StaticResource SecondaryText}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Цена:"
                                               Foreground="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding Price}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryText}"/>

                                    <TextBlock Text="{Binding CityName}"
                                               Foreground="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding CategoryName}"
                                               Foreground="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding AdTypeName}"
                                               Foreground="{StaticResource SecondaryText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">

                                    <Button Content="Редактировать"
                                            FontFamily="Tw Cen MT"
                                            FontSize="12"
                                            Background="{StaticResource AccentColor}"
                                            Foreground="White"
                                            Padding="5"
                                            Margin="0 0 0 8"
                                            Tag="{Binding AdID}"
                                            Click="EditAd_Click"
                                            Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}"/>

                                    <Button Content="Удалить"
                                            FontFamily="Tw Cen MT"
                                            FontSize="12"
                                            Background="#E53935"
                                            Foreground="White"
                                            Padding="5"
                                            Tag="{Binding AdID}"
                                            Click="DeleteAd_Click"
                                            Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}"/>

                                </StackPanel>

                            </Grid>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Page>
