<Page x:Class="Pisetskii_Poltorabatko_PrivateAdertisementService.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pisetskii_Poltorabatko_PrivateAdertisementService"
      mc:Ignorable="d" 
           d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление / редактирование объявления">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#37474F"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#78909C"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF9C1A"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="15">

            <TextBlock Text="Название" FontFamily="Tw Cen MT" Foreground="{StaticResource PrimaryText}"/>
            <TextBox x:Name="TitleBox"
                     FontFamily="Tw Cen MT"
                     FontSize="14"
                     Height="30"
                     Margin="0 8 0 16"/>

            <TextBlock Text="Описание" FontFamily="Tw Cen MT" Foreground="{StaticResource PrimaryText}"/>
            <TextBox x:Name="DescriptionBox"
                     FontFamily="Tw Cen MT"
                     FontSize="14"
                     Height="80"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Margin="0 8 0 16"/>

            <TextBlock Text="Цена" FontFamily="Tw Cen MT" Foreground="{StaticResource PrimaryText}"/>
            <TextBox x:Name="PriceBox"
                     FontFamily="Tw Cen MT"
                     FontSize="14"
                     Height="30"
                     Margin="0 8 0 16"/>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                <StackPanel Width="150">
                    <TextBlock Text="Город" FontFamily="Tw Cen MT"/>
                    <ComboBox x:Name="CityBox" Height="30" FontFamily="Tw Cen MT"/>
                </StackPanel>

                <StackPanel Width="150" Margin="16 0 0 0">
                    <TextBlock Text="Категория" FontFamily="Tw Cen MT"/>
                    <ComboBox x:Name="CategoryBox" Height="30" FontFamily="Tw Cen MT"/>
                </StackPanel>

                <StackPanel Width="150" Margin="16 0 0 0">
                    <TextBlock Text="Тип" FontFamily="Tw Cen MT"/>
                    <ComboBox x:Name="TypeBox" Height="30" FontFamily="Tw Cen MT"/>
                </StackPanel>

                <StackPanel Width="150" Margin="16 0 0 0">
                    <TextBlock Text="Статус объявления" FontFamily="Tw Cen MT"/>
                    <ComboBox x:Name="StatusBox" Height="30" FontFamily="Tw Cen MT"/>
                </StackPanel>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                <Image x:Name="AdImage"
                       Width="150"
                       Height="150"
                       Stretch="UniformToFill"
                       Margin="0 0 16 0"/>

            </StackPanel>
            <Button Content="Выбрать фото"
                    Background="{StaticResource AccentColor}"
                    Foreground="White"
                    Padding="10"
                    Width="150"
                    FontFamily="Tw Cen MT"
                    Click="ChooseImage_Click"/>

            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Background="{StaticResource AccentColor}"
                    Foreground="White"
                    FontFamily="Tw Cen MT"
                    FontSize="16"
                    Height="40"
                    Margin="0 20 0 0"
                    Click="Save_Click"/>

        </StackPanel>

    </ScrollViewer>
</Page>
