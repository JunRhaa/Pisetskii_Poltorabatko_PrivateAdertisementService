<Page x:Class="Pisetskii_Poltorabatko_PrivateAdertisementService.UserAdsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pisetskii_Poltorabatko_PrivateAdertisementService"
      mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800"
      Title="Мои объявления">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="10">

                <TextBlock Text="Мои объявления"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <Button Content="Добавить объявление"
                            Padding="10 5"
                            Background="#4CAF50"
                            Foreground="White"
                            Click="Add_Click"
                            Margin="0,0,10,0"/>
                    <Button Content="Завершенные объявления" 
                            Padding="10 5"
                            Background="#FF9C1A"
                            Foreground="White"
                            Click="ShowCompletedAds_Click"
                            Margin="0,0,10,0"/>
                    <Button Content="Все объявления" 
                            Padding="10 5"
                            Background="#FF9C1A"
                            Foreground="White" 
                            Click="AdsPage_Click"/>
                </StackPanel>

                <ItemsControl x:Name="UserAdsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1"
                                    CornerRadius="8" Margin="5" Padding="10"
                                    Background="White">

                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding ImagePath}"
                                           Width="140" Height="140"
                                           Stretch="UniformToFill"
                                           Margin="5"/>

                                    <StackPanel Grid.Column="1" Margin="10">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Margin="0 5 0 5"/>
                                        <TextBlock Text="{Binding Price, StringFormat='Цена: {0} ₽'}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}"
                                                   Margin="0 5 0 0"
                                                   Foreground="Gray"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <Button Content="Редактировать"
                                                Margin="0 5"
                                                Tag="{Binding AdID}" 
                                                Click="Edit_Click"/>
                                        <Button Content="Завершить"
                                                Margin="0 5"
                                                Background="#EF5350"
                                                Foreground="White"
                                                Tag="{Binding AdID}" 
                                                Click="Finish_Click"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>